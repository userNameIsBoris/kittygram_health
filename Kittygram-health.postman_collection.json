            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/clinics/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ветклиника\",\n  \"address\": \"ул. Мира, 1\",\n  \"phone\": \"+7 000 000-00-00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{admin_username}}",
              "type": "string"
            },
            {
