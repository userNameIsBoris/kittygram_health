{
  "info": {
    "name": "Kittygram — паспорт здоровья кота",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "cat_id",
      "value": ""
    },
    {
      "key": "clinic_id",
      "value": ""
    },
    {
      "key": "record_id",
      "value": ""
    },
    {
      "key": "admin_username",
      "value": ""
    },
    {
      "key": "admin_password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Создать клинику — администратор",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/clinics/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ветклиника\",\n  \"address\": \"ул. Мира, 1\",\n  \"phone\": \"+7 000 000-00-00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{admin_username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{admin_password}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set(\"clinic_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Создать кота",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/cats/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Мурка\",\n  \"color\": \"серая\",\n  \"birth_year\": 2022\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set(\"cat_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Список клиник",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/clinics/"
      },
      "response": []
    },
    {
      "name": "Создать запись",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/cats/{{cat_id}}/health-records/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"record_type\": \"visit\",\n  \"date\": \"2026-10-22\",\n  \"clinic\": \"{{clinic_id}}\",\n  \"description\": \"Плановый осмотр\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set(\"record_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Список записей с фильтром и пагинацией",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/cats/{{cat_id}}/health-records/?type=visit&date_from=2026-10-22&page=1&page_size=10"
      },
      "response": []
    },
    {
      "name": "Получить запись",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/health-records/{{record_id}}/"
      },
      "response": []
    },
    {
      "name": "Обновить запись",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/health-records/{{record_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Осмотр завершён\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Завершить запись",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/health-records/{{record_id}}/complete/",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Удалить запись",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/health-records/{{record_id}}/"
      },
      "response": []
    }
  ]
}
